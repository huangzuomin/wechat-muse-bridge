# Required: comma-separated iLink from_user_id values allowed to reach Muse.
ALLOWED_USER_IDS=replace-with-your-wechat-user-id

# Persistent private data directory (credentials.json and state.json are mode 0600).
WECHAT_MUSE_DATA_DIR=/var/lib/wechat-muse-bridge

# The Pi installer replaces this with the service account's resolved CLI path.
MUSEGADGET_COMMAND=musegadget

MAX_MESSAGE_CHARS=8000
ILINK_API_BASE_URL=https://ilinkai.weixin.qq.com
ILINK_POLL_TIMEOUT_MS=35000
HTTP_TIMEOUT_SECONDS=45
LOG_LEVEL=INFO
DEBUG_PAYLOADS=false
